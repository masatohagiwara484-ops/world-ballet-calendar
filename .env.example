# première — environment variables
# Copy to .env.local and fill in. The site renders fully without Supabase
# (bundled dataset floor); keys below unlock live data, ingestion & approval.

# Supabase (public — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER exposed to the client (seed, ingest, approval webhook)
SUPABASE_SERVICE_ROLE_KEY=

# LLM extraction in the ingest pipeline (claude-haiku)
ANTHROPIC_API_KEY=

# Telegram approval flow (optional — review:pending CLI works without it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Optional — venue maps upgrade from Leaflet to Google Maps when set
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Affiliate ids (all optional — links work without them, they just earn nothing.
# NEXT_PUBLIC_* because the links render client-side; ids are not secrets.)
NEXT_PUBLIC_BOOKING_AID=
NEXT_PUBLIC_GYG_PARTNER_ID=
NEXT_PUBLIC_TIQETS_PARTNER=
NEXT_PUBLIC_TRAINLINE_PID=
NEXT_PUBLIC_WELCOME_PICKUPS_REF=
NEXT_PUBLIC_AIRALO_REF=

# Follower email alerts (Resend). Unset → alerts silently skip (site unaffected).
# EMAIL_FROM defaults to onboarding@resend.dev (test-only) until the custom
# domain is verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Weekly digest cron (Vercel Cron sends "Authorization: Bearer $CRON_SECRET").
# Any random string; the route refuses to run when this is unset.
CRON_SECRET=
